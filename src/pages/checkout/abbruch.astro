---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Bestellung abgebrochen" noindex={true}>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-20 text-center">
    <h1 class="text-3xl font-bold mb-3">Bestellung abgebrochen</h1>
    <p class="text-muted mb-8">
      Dein Warenkorb ist noch vorhanden – du kannst die Bestellung jederzeit fortsetzen.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/warenkorb" class="sticker inline-block bg-ink text-bg font-bold px-6 py-3 rounded-sm">
        Zurück zum Warenkorb
      </a>
      <a href="/produkte" class="inline-block border-2 border-ink font-bold px-6 py-3 rounded-sm transition-colors hover:bg-ink hover:text-bg">
        Weiter einkaufen
      </a>
    </div>
  </div>
</BaseLayout>
