---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SHIPPING } from '@/data/shipping';
---

<BaseLayout title="Versand" description="Versandinformationen für Bestellungen im Carlu's Shop.">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <p class="mono-tag mb-2">Logistik</p>
    <h1 class="text-3xl font-bold mb-8">Versand</h1>

    <div class="space-y-6 text-ink">
      <section>
        <h2 class="font-semibold mb-2">Lieferländer</h2>
        <p>Wir liefern nach: <strong>{SHIPPING.countries.join(', ')}</strong></p>
      </section>

      <section class="spec-rule pt-4">
        <h2 class="font-semibold mb-2">Versandkosten</h2>
        <ul class="text-sm space-y-1 text-muted">
          <li>Pauschal: <strong class="text-ink">{SHIPPING.flatRateEUR.toFixed(2).replace('.', ',')} €</strong></li>
          <li>Kostenlos ab: <strong class="text-ink">{SHIPPING.freeAboveEUR.toFixed(2).replace('.', ',')} € Bestellwert</strong></li>
        </ul>
      </section>

      <section class="spec-rule pt-4">
        <h2 class="font-semibold mb-2">Lieferzeit</h2>
        <p class="text-sm text-muted">
          <strong class="text-ink">{SHIPPING.estimatedDaysMin}–{SHIPPING.estimatedDaysMax} Werktage</strong> nach Zahlungseingang.
          Versand via <strong class="text-ink">{SHIPPING.carrier}</strong>.
        </p>
      </section>

      <section class="spec-rule pt-4">
        <h2 class="font-semibold mb-2">Wichtige Hinweise</h2>
        <ul class="text-sm text-muted space-y-1 list-disc list-inside">
          <li>Alle Preise inkl. gesetzlicher MwSt.</li>
          <li>Lieferung nur an Privatpersonen und Unternehmen in den genannten Ländern.</li>
          <li>Bei Fragen: <a href="/kontakt" class="underline hover:text-accent">Kontaktformular</a></li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
