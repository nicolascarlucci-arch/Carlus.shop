---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Kontakt" description="Kontaktiere Carlu's Shop – wir helfen dir gerne weiter.">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <p class="mono-tag mb-2">Support</p>
    <h1 class="text-3xl font-bold mb-8">Kontakt</h1>

    <form id="contact-form" class="space-y-5">
      <!-- Honeypot -->
      <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

      <div>
        <label class="block text-sm font-medium mb-1.5" for="name">Name</label>
        <input type="text" id="name" name="name" required
          class="w-full border border-line rounded-sm px-3 py-2 bg-surface focus:outline-none focus:border-ink"
          placeholder="Dein Name" />
      </div>
      <div>
        <label class="block text-sm font-medium mb-1.5" for="email">E-Mail</label>
        <input type="email" id="email" name="email" required
          class="w-full border border-line rounded-sm px-3 py-2 bg-surface focus:outline-none focus:border-ink"
          placeholder="deine@email.de" />
      </div>
      <div>
        <label class="block text-sm font-medium mb-1.5" for="message">Nachricht</label>
        <textarea id="message" name="message" rows="5" required
          class="w-full border border-line rounded-sm px-3 py-2 bg-surface focus:outline-none focus:border-ink resize-none"
          placeholder="Wie können wir dir helfen?"></textarea>
      </div>

      <div id="form-error" class="hidden fade-in text-sm text-accent bg-accent/5 border border-accent/20 rounded-sm px-3 py-2"></div>
      <div id="form-success" class="hidden fade-in text-sm text-success bg-success/5 border border-success/20 rounded-sm px-3 py-2">
        Deine Nachricht wurde gesendet. Wir melden uns bald!
      </div>

      <button type="submit" class="bg-ink text-bg font-semibold px-6 py-3 rounded-full transition-all hover:bg-accent hover:scale-[1.02]">
        Nachricht senden
      </button>
    </form>
  </div>
</BaseLayout>

<script>
  // See src/pages/produkte/[slug].astro for why this lives inside
  // astro:page-load rather than at the top level: Astro's view-transition
  // router dedupes identical inline scripts, so without this the form
  // would go dead on a second visit to /kontakt in the same session.
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const errEl = document.getElementById('form-error');
    const successEl = document.getElementById('form-success');
    if (!form || !errEl || !successEl) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.classList.add('hidden');
      successEl.classList.add('hidden');

      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Senden…';

      try {
        const res = await fetch('/api/kontakt', { method: 'POST', body: new FormData(form) });
        const data = await res.json();
        if (data.ok) {
          form.reset();
          successEl.classList.remove('hidden');
        } else {
          errEl.textContent = data.error ?? 'Fehler beim Senden.';
          errEl.classList.remove('hidden');
        }
      } catch {
        errEl.textContent = 'Netzwerkfehler. Bitte versuche es erneut.';
        errEl.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Nachricht senden';
      }
    });
  }

  document.addEventListener('astro:page-load', setupContactForm);
</script>
